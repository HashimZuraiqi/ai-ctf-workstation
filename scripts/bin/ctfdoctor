#!/usr/bin/env bash
set -u
export PATH="$HOME/.local/bin:$PATH"
pass=0; warns=0; fails=0
ok(){ printf '\033[1;32m[OK]\033[0m   %s\n' "$*"; pass=$((pass+1)); }
warn(){ printf '\033[1;33m[WARN]\033[0m %s\n' "$*"; warns=$((warns+1)); }
fail(){ printf '\033[1;31m[FAIL]\033[0m %s\n' "$*"; fails=$((fails+1)); }
cmd_required(){ local c="$1"; if command -v "$c" >/dev/null 2>&1; then ok "$c -> $(command -v "$c")"; else fail "$c missing"; fi; }
cmd_optional(){ local c="$1"; if command -v "$c" >/dev/null 2>&1; then ok "$c -> $(command -v "$c")"; else warn "$c missing"; fi; }

printf 'AI CTF Workstation Doctor\n==========================\n'
if [[ -r /etc/os-release ]]; then . /etc/os-release; ok "OS: ${PRETTY_NAME:-unknown}"; fi
if grep -Rqs 'Suites: kali-rolling' /etc/apt/sources.list.d 2>/dev/null; then ok "Kali Rolling source found"; else warn "Kali Rolling Deb822 source not detected"; fi
if command -v dpkg >/dev/null 2>&1 && [[ -z "$(dpkg --audit 2>/dev/null)" ]]; then ok "dpkg audit clean"; else warn "dpkg audit returned output"; fi

printf '\n-- Core --\n'
for c in git curl jq node npm npx uv gdb gdb-multiarch checksec rz-bin qemu-x86_64 docker ctfnew ctf-mcp ghidra-ai ctftriage ctfflag; do cmd_required "$c"; done
for c in codex agy claude gemini pwndbg cutter jadx apktool playwright-cli; do cmd_optional "$c"; done

VENV="$HOME/.venvs/ctf-core"
[[ -x "$VENV/bin/python" ]] && ok "Python CTF venv exists" || fail "Python CTF venv missing"
if [[ -x "$VENV/bin/python" ]]; then
  if "$VENV/bin/python" - <<'PY_DOC' >/dev/null 2>&1
mods=['pwn','z3','Crypto','sympy','capstone','unicorn','keystone','lief','ropper','requests','bs4','lxml','PIL','angr','gmpy2','ecdsa','cryptography','pyasn1','base58','bitarray']
for m in mods: __import__(m)
PY_DOC
  then ok "Python CTF imports pass"; else warn "One or more Python CTF imports failed"; fi
fi

printf '\n-- Reverse / Pwn --\n'
JAVA21=/usr/lib/jvm/java-21-openjdk-amd64
[[ -x "$JAVA21/bin/java" ]] && ok "Java 21 present" || fail "Java 21 missing"
GHIDRA="$HOME/tools/ghidra_12.1.2_PUBLIC"
[[ -x "$GHIDRA/ghidraRun" ]] && ok "Official Ghidra 12.1.2 present" || fail "Official Ghidra 12.1.2 missing"
[[ -d "$HOME/tools/ghidra-mcp" ]] && ok "Ghidra MCP source present" || fail "Ghidra MCP source missing"
if curl -fsS --max-time 1 http://127.0.0.1:8089/get_version >/tmp/ctfdoctor-ghidra.json 2>/dev/null; then
  ok "Ghidra MCP plugin reachable"
  command -v jq >/dev/null && jq -c . /tmp/ctfdoctor-ghidra.json 2>/dev/null || true
else warn "Ghidra MCP plugin offline (normal if Ghidra is closed)"; fi
rm -f /tmp/ctfdoctor-ghidra.json

printf '\n-- Forensics --\n'
for c in exiftool binwalk yara mmls fls tsk_recover pdfid pdf-parser oleid olevba tshark steghide stegseek zsteg pngcheck vol; do cmd_optional "$c"; done
for c in plaso-log2timeline plaso-pinfo plaso-psort; do cmd_optional "$c"; done

printf '\n-- Crypto --\n'
for c in openssl john hashcat hashid gp ccrypt aesfix aeskeyfind stegsnow xortool RsaCtfTool sage; do cmd_optional "$c"; done

printf '\n-- OSINT --\n'
for c in whois dig dnsrecon dnsenum massdns amass subfinder assetfinder theHarvester sherlock maigret recon-ng metagoofil waybackpy instaloader; do cmd_optional "$c"; done

printf '\n-- CTF helpers --\n'
if command -v ctfflag >/dev/null 2>&1 && ctfflag decode "ZmxhZ3t0ZXN0fQ==" 2>/dev/null | grep -q "flag{test}"; then ok "ctfflag decoder works"; else warn "ctfflag decode self-test failed"; fi
if command -v ctftriage >/dev/null 2>&1; then ok "ctftriage installed"; else warn "ctftriage missing"; fi
if command -v ctfmodel >/dev/null 2>&1; then ok "ctfmodel installed"; else warn "ctfmodel missing"; fi
if command -v ctfhub >/dev/null 2>&1; then ok "ctfhub installed (run: ctfhub)"; else warn "ctfhub missing"; fi
if command -v ctfsolve >/dev/null 2>&1; then
  if [[ -n "${CTFSOLVE_API_BASE:-}" && -n "${CTFSOLVE_MODEL:-}" ]]; then ok "ctfsolve installed (endpoint configured)"; else warn "ctfsolve installed (set CTFSOLVE_API_BASE + CTFSOLVE_MODEL to use it)"; fi
else warn "ctfsolve missing"; fi

printf '\n-- Custom MCP servers --\n'
for n in forensics crypto osint; do
  d="$HOME/tools/ctf-$n-mcp"
  if [[ -x "$d/.venv/bin/python" && -f "$d/server.py" ]]; then ok "$n MCP installed"; else warn "$n MCP missing"; fi
done

printf '\n-- Skills / configs --\n'
for base in "$HOME/.agents/skills" "$HOME/.claude/skills" "$HOME/.gemini/antigravity-cli/skills"; do
  if [[ -d "$base" ]]; then n=$(find "$base" -mindepth 2 -maxdepth 2 -name SKILL.md 2>/dev/null | wc -l); ((n>=11)) && ok "Skills: $base ($n)" || warn "Skills: $base ($n, expected >=11)"; else warn "Skills directory missing: $base"; fi
done
AGY_CFG="$HOME/.gemini/config/mcp_config.json"
if [[ -s "$AGY_CFG" ]] && python3 -m json.tool "$AGY_CFG" >/dev/null 2>&1; then ok "Antigravity MCP JSON valid"; else warn "Antigravity MCP config missing/invalid"; fi
PW_CFG="$HOME/.config/ctf-ai/playwright-mcp.json"
if [[ -s "$PW_CFG" ]] && python3 -m json.tool "$PW_CFG" >/dev/null 2>&1; then ok "Playwright MCP JSON valid"; else fail "Playwright MCP config missing/invalid"; fi
if command -v docker >/dev/null 2>&1; then if docker info >/dev/null 2>&1; then ok "Docker daemon accessible"; else warn "Docker installed but daemon/socket unavailable"; fi; fi

echo; printf 'Summary: %d OK, %d warnings, %d failures\n' "$pass" "$warns" "$fails"
((fails==0))
